// CLIMB-BIG-DATA notebooks.
// Nextflow on CLIMB runs every task as a Kubernetes pod. CLIMB's /etc/nextflow.config holds the pod
// settings (the /shared/team volume, node selector, security context) but Nextflow does not load it on
// its own, so it is included here (this include is only read when -profile climb is used).
// There is no Docker: tasks run in the notebook image and take their tools from conda envs stored on
// /shared/team (pods cannot see /home/jovyan):
//   tools/env-clust-assess.yml + ACCIO  -> --clust_assess_env /shared/team/<dir>/env-core
//   tools/env-mobsuite.yml              -> --mobsuite_env / --amrfinder_env /shared/team/<dir>/env-mobsuite
// Launch from a /shared/team path (not ~/shared-team) so every staged path resolves inside the pods.

includeConfig '/etc/nextflow.config'

params.max_cpus    = 4
params.climb_image = System.getenv('JUPYTER_IMAGE_SPEC') ?: 'ubuntu:24.04'

process {
    executor     = 'k8s'
    container    = params.climb_image
    beforeScript = "export PATH=${params.clust_assess_env}/bin:${params.mobsuite_env}/bin:${params.amrfinder_env}/bin:\$PATH"
}
