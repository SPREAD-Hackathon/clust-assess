manifest {
    name            = 'clust-assess'
    description     = 'Assessing pling clusters of potentially related plasmids'
    version         = '0.1.0'
    nextflowVersion = '>=24.04'
    mainScript      = 'main.nf'
}

params {
    version           = '0.1.0'
    mode              = 'assess'          // build_db | assess | all
    input             = null              // multi-FASTA(s) of plasmids of interest 
    db                = null              // ACCIO/Pling database (accio create output), e.g. the PLSDB Pling DB
    refs              = null              // build_db / all: reference plasmid FASTA(s)
    db_outdir         = "$baseDir/db"
    db_name           = 'clust_assess_db'
    results_dir       = "$baseDir/results"

    queries_circular  = true              // inputs are complete circular plasmids (ACCIO 'circular=true')
    refs_circular     = true

    containment       = 0.5               // Pling containment-distance threshold 
    dcj               = 4                 // Pling DCJ-Indel threshold
    k_closest         = 20                // closest DB members per subcommunity used as the baseline (0 = all)
    baseline_members  = 'all'             // all: include ACCIO-deduplicated copies; representatives: plasmidDB.fasta only
    n_resample        = 1000
    alpha             = 0.05
    seed              = 2026

    accio_create_args = ''
    accio_find_args   = ''
    pling_args        = '--visualisation none'
    max_cpus          = 4                

    clust_assess_env  = "${System.getenv('HOME')}/miniforge3/envs/clust-assess"
    mobsuite_env      = "${System.getenv('HOME')}/miniforge3/envs/mobsuite"      
    amrfinder_env     = "${System.getenv('HOME')}/miniforge3/envs/fedplasmid-amr" 
    container         = 'clust-assess:0.1.0'
}

process {
    errorStrategy = 'terminate'
    cpus   = 1
    memory = '2 GB'

    withName: ACCIO_BUILD   { cpus = { Math.min(4, params.max_cpus as int) }; memory = '8 GB'; time = '48h' }
    withName: ACCIO_CALL    { cpus = { Math.min(2, params.max_cpus as int) }; memory = '4 GB'; maxForks = 2 }
    withName: PLING_MEMBERS { cpus = { Math.min(4, params.max_cpus as int) }; memory = '6 GB'; maxForks = 1 }
    withName: PLING_INPUTS  { cpus = { Math.min(4, params.max_cpus as int) }; memory = '6 GB' }
}

profiles {
    standard {
        process.executor     = 'local'
        executor.memory      = '10 GB'
        process.beforeScript = "export PATH=${params.clust_assess_env}/bin:${params.mobsuite_env}/bin:${params.amrfinder_env}/bin:\$PATH"
    }
    docker {
        docker.enabled    = true
        process.container = params.container
    }
    climb {
        includeConfig 'conf/climb.config'
    }
    test {
        params.mode        = 'all'
        params.refs        = "$baseDir/test_data/refs.fasta"
        params.input       = "$baseDir/test_data/inputs.fasta"
        params.db_outdir   = "$baseDir/test_data/db"
        params.db_name     = 'test_db'
        params.results_dir = "$baseDir/results_test"
        params.k_closest   = 10
        params.n_resample  = 500
    }
    stub {
        params.mode        = 'all'
        params.refs        = "$baseDir/tests/stub_data/refs.fasta"
        params.input       = "$baseDir/tests/stub_data/inputs.fasta"
        params.db_outdir   = "$baseDir/results_stub/db"
        params.db_name     = 'stub_db'
        params.results_dir = "$baseDir/results_stub"
    }
}

timeline { enabled = true; overwrite = true; file = "${params.results_dir}/runningstat/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.results_dir}/runningstat/execution.html" }
trace    { enabled = true; overwrite = true; file = "${params.results_dir}/runningstat/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.results_dir}/runningstat/dag.html" }
